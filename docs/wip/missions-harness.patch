+  p.health = p.maxHealth;
+  g.police.bust = 0; // no arrests: an autoplayer stands still next to cops (a chunk is too short to reach a bust)
+  const step = T.cur;
+  const kind = step ? ms.constructor.kindOf(step) : 'none';
